{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "tamaspeak.vercel.app" }],
      "destination": "https://tamaspeak.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth-routes" }
  ],
  "functions": {
    "api/setup.js": { "includeFiles": "db/schema.sql" }
  },
  "crons": [
    { "path": "/api/cron/relances", "schedule": "0 9 * * *" },
    { "path": "/api/cron/palmares", "schedule": "30 8 * * *" }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/audio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
