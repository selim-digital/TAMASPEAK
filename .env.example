# Tama Speak — variables d'environnement du serveur (fonctions Vercel).
#
# RÈGLE : TOUT EST OPTIONNEL. Sans ces variables, l'app fonctionne à 100 %
# en mode local (pas de compte, pas de sync, pas d'email) — c'est le mode
# par défaut, et il le reste. Chaque variable ALLUME une capacité.
#
# À renseigner dans Vercel → Settings → Environment Variables (pas ici :
# ce fichier est un modèle, il ne doit JAMAIS contenir de vraie valeur).

# --- Base de données (allume : comptes, sync, événements, feedback, admin) ---
# Projet Neon à créer en région eu-central-1 (Francfort) — décision RGPD.
# Copier la « pooled connection string » de Neon.
DATABASE_URL=

# --- Authentification -------------------------------------------------------
# Secret de session : générer avec `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL publique de l'app (sert aux redirections OAuth et aux liens magiques).
BETTER_AUTH_URL=https://tamaspeak.vercel.app

# --- Google OAuth (allume : « Continuer avec Google ») ----------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (type Web). Redirect URI à déclarer chez Google :
#   https://tamaspeak.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email via Resend (allume : lien magique par email, relances) -----------
# Sans cette clé, le lien magique s'écrit dans les logs Vercel (suffisant
# pour tester). Domaine à vérifier chez Resend d'abord — utiliser un
# SOUS-domaine d'envoi pour isoler la réputation (recommandation Resend).
RESEND_API_KEY=
EMAIL_FROM=Tama Speak <bonjour@send.tamaspeak.com>
APP_URL=https://tamaspeak.vercel.app
UNSUB_URL=https://tamaspeak.vercel.app/api/unsubscribe

# --- Admin ------------------------------------------------------------------
# Emails autorisés à voir le tableau de bord, séparés par des virgules.
ADMIN_EMAILS=
